# ───────────────────────────────────────────────────────────────
# Rete Mali web app — environment template
# Copy to .env.local (`cp .env.example .env.local`) and fill in.
# ───────────────────────────────────────────────────────────────

# BUILD-TIME variable — inlined into the browser bundle by `next build`.
# Changing it requires a REBUILD (in Docker: `--build-arg NEXT_PUBLIC_API_URL=...`).
# It is only used for public asset URLs (uploaded book covers, QRIS codes,
# avatars, payment proofs) and whitelists the API host for next/image.
# API calls from the browser go same-origin to `/api/backend/*` instead.
NEXT_PUBLIC_API_URL=http://localhost:2000/api

# RUNTIME variable — read by the Next.js route handlers, BFF and server code
# (server side only, never shipped to the browser). This is what actually
# points at the Express API. Local dev runs on port 2000; Docker/production
# overrides this with the internal service URL.
API_URL=http://localhost:2000/api

# Optional. WhatsApp CTA number in international format without "+".
NEXT_PUBLIC_WHATSAPP_NUMBER=6281234567890
